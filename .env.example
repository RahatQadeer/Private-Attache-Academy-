# Shared Supabase project for the whole Private Attaché ecosystem.
# Set these once on the Vercel project — do not generate per-module copies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Auth emails and OAuth callbacks use this origin.
NEXT_PUBLIC_SITE_URL=https://private-attache-dun.vercel.app

# Switcher behavior for products the user is not entitled to.
# "grey" = show the card muted with an apply/explore action (default)
# "hide" = omit unentitled products from the grid
NEXT_PUBLIC_SWITCHER_UNENTITLED=grey
